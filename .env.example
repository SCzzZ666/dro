# ======== Dro v2 环境配置（复制为 .env 后填写） ========

# 阿里云 DashScope Key（Qwen-VL / DeepSeek 统一使用）
DASHSCOPE_API_KEY=你的-dashscope-api-key

# ADB 设备序列号（adb devices 查看）
DEVICE_SERIAL=127.0.0.1:16416

# ---- 可选：覆盖默认模型 ----
# DEFAULT_MODEL=qwen3-vl-plus
# DEEPSEEK_MODEL=deepseek-v3.2
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v3   # 向量维度：v3=1024，v1/v2=1536
# EMBEDDING_DIM=1024                  # 必须与 EMBEDDING_MODEL 输出维度一致

# ---- 可选：任务参数 ----
# MAX_STEPS=15
# TOOL_TIMEOUT=10
# TASK_TIMEOUT=300

# ---- 可选：Qdrant（长期偏好向量记忆；不填则 SQLite 兜底） ----
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=dro_preferences

# ---- 可选：PostgreSQL（用户画像；不填则 SQLite 兜底） ----
# POSTGRES_DSN=postgresql://user:pass@localhost:5432/dro